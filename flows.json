    {
        "id": "9e153f89547c42cc",
        "type": "function",
        "z": "tab-proxy",
        "name": "存储Token",
        "func": "try {\n    const resp = JSON.parse(msg.payload);\n    if (resp && resp.access_token) {\n        flow.set(\"jwt_token\", resp.access_token);\n        node.warn(\"JWT Token OK, 有效\" + resp.expires_minutes + \"分钟\");\n    } else {\n        node.error(\"登录失败: \" + msg.payload);\n    }\n} catch(e) {\n    node.error(\"登录出错: \" + e.message);\n}\n",
        "outputs": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 910,
        "y": 80,
        "wires": []
    },
    {
        "id": "d8eb105af355453d",
        "type": "function",
        "z": "tab-proxy",
        "name": "注入 JWT Token",
        "func": "const token = flow.get(\"jwt_token\");\nif (token) {\n    msg.headers = msg.headers || {};\n    msg.headers[\"Authorization\"] = \"Bearer \" + token;\n}\n// API breaking change: new Bridge expects plain array, dashboard sends {node_ids: [...]}\nif (msg.payload && typeof msg.payload === \"object\" && msg.payload.node_ids) {\n    msg.payload = msg.payload.node_ids;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 220,
        "wires": [
            [
                "http-proxy-req-batch"
            ]
        ]
    },
